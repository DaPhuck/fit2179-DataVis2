{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "#111d30",
    "title": {
        "text": "Geomagnetic Storm Intensity Calendar, 1990–2025",
        "subtitle": "Monthly maximum Kp index · Click a cell to highlight its month + year · Click again to clear",
        "fontSize": 18,
        "subtitleFontSize": 13,
        "font": "system-ui, -apple-system, sans-serif",
        "subtitleFont": "system-ui, -apple-system, sans-serif",
        "anchor": "start",
        "color": "#e8e2d4",
        "subtitleColor": "#7a8ba3",
        "subtitlePadding": 6,
        "offset": 12
    },
    "width": 560,
    "height": {
        "step": 21
    },
    "params": [
        {
            "name": "cycleSel",
            "value": "All",
            "bind": {
                "input": "select",
                "options": [
                    "All",
                    "SC22",
                    "SC23",
                    "SC24",
                    "SC25"
                ],
                "name": "Solar Cycle: "
            }
        }
    ],
    "layer": [
        {
            "description": "Heatmap cells",
            "data": {
                "url": "https://raw.githubusercontent.com/DaPhuck/fit2179-DataVis2/refs/heads/main/data/gfz_kp_monthly.csv"
            },
            "transform": [
                {
                    "calculate": "+datum.year",
                    "as": "year_num"
                },
                {
                    "filter": "cycleSel == 'All' || (cycleSel == 'SC22' && datum.year_num <= 1996) || (cycleSel == 'SC23' && datum.year_num >= 1996 && datum.year_num <= 2008) || (cycleSel == 'SC24' && datum.year_num >= 2008 && datum.year_num <= 2019) || (cycleSel == 'SC25' && datum.year_num >= 2019)"
                },
                {
                    "calculate": "datum.max_kp < 3 ? 'Quiet (< 3)' : datum.max_kp < 5 ? 'Active (3–5)' : datum.max_kp < 7 ? 'Storm (5–7)' : datum.max_kp < 8 ? 'Strong Storm (7–8)' : 'Extreme (≥ 8)'",
                    "as": "kp_level"
                }
            ],
            "params": [
                {
                    "name": "hover",
                    "select": {
                        "type": "point",
                        "on": "mouseover"
                    }
                },
                {
                    "name": "focus",
                    "select": {
                        "type": "point",
                        "fields": [
                            "month_name",
                            "year"
                        ],
                        "on": "click",
                        "toggle": "event.shiftKey"
                    }
                }
            ],
            "mark": {
                "type": "rect",
                "stroke": "#ffffff",
                "strokeWidth": 0.4
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal",
                    "title": "Year",
                    "axis": {
                        "labelColor": "#e8e2d4",
                        "titleColor": "#e8e2d4",
                        "gridColor": "#2a3a52",
                        "labelFont": "system-ui, -apple-system, sans-serif",
                        "titleFont": "system-ui, -apple-system, sans-serif",
                        "labelFontSize": 10,
                        "titleFontSize": 12,
                        "titleFontWeight": "normal",
                        "labelAngle": -45,
                        "ticks": false,
                        "domain": false,
                        "labelPadding": 6
                    }
                },
                "y": {
                    "field": "month_name",
                    "type": "ordinal",
                    "title": "Month",
                    "sort": [
                        "Jan",
                        "Feb",
                        "Mar",
                        "Apr",
                        "May",
                        "Jun",
                        "Jul",
                        "Aug",
                        "Sep",
                        "Oct",
                        "Nov",
                        "Dec"
                    ],
                    "axis": {
                        "labelColor": "#e8e2d4",
                        "titleColor": "#e8e2d4",
                        "gridColor": "#2a3a52",
                        "labelFont": "system-ui, -apple-system, sans-serif",
                        "titleFont": "system-ui, -apple-system, sans-serif",
                        "labelFontSize": 11,
                        "titleFontSize": 12,
                        "titleFontWeight": "normal",
                        "labelPadding": 8,
                        "ticks": false,
                        "domain": false
                    }
                },
                "color": {
                    "field": "max_kp",
                    "type": "quantitative",
                    "scale": {
                        "type": "threshold",
                        "domain": [
                            3,
                            5,
                            7,
                            8
                        ],
                        "range": [
                            "#2166ac",
                            "#92c5de",
                            "#f4a582",
                            "#d6604d",
                            "#b2182b"
                        ]
                    },
                    "legend": {
                        "labelColor": "#e8e2d4",
                        "titleColor": "#e8e2d4",
                        "title": "Max Monthly Kp",
                        "titleFont": "system-ui, -apple-system, sans-serif",
                        "titleFontSize": 11,
                        "labelFont": "system-ui, -apple-system, sans-serif",
                        "labelFontSize": 10,
                        "orient": "right",
                        "values": [
                            3,
                            5,
                            7,
                            8
                        ],
                        "labelExpr": "datum.value === 3 ? '< 3  Quiet' : datum.value === 5 ? '3–5  Active' : datum.value === 7 ? '5–7  Storm' : '7–8  Strong · ≥8 Extreme'"
                    }
                },
                "opacity": {
                    "condition": {
                        "test": "!focus || !focus.month_name || indexof(focus.month_name, datum.month_name) >= 0 || indexof(focus.year, datum.year) >= 0",
                        "value": 1
                    },
                    "value": 0.18
                },
                "strokeWidth": {
                    "condition": {
                        "param": "hover",
                        "value": 2,
                        "empty": false
                    },
                    "value": 0.4
                },
                "stroke": {
                    "condition": {
                        "param": "hover",
                        "value": "#ffffff",
                        "empty": false
                    },
                    "value": "#ffffff"
                },
                "tooltip": [
                    {
                        "field": "year",
                        "type": "ordinal",
                        "title": "Year"
                    },
                    {
                        "field": "month_name",
                        "type": "nominal",
                        "title": "Month"
                    },
                    {
                        "field": "max_kp",
                        "type": "quantitative",
                        "title": "Max Kp",
                        "format": ".1f"
                    },
                    {
                        "field": "kp_level",
                        "type": "nominal",
                        "title": "Level"
                    }
                ]
            }
        },
        {
            "description": "Notable event labels on extreme cells",
            "data": {
                "values": [
                    {
                        "year": "2003",
                        "year_num": 2003,
                        "month_name": "Oct",
                        "label": "★"
                    },
                    {
                        "year": "2003",
                        "year_num": 2003,
                        "month_name": "Nov",
                        "label": "★"
                    },
                    {
                        "year": "2024",
                        "year_num": 2024,
                        "month_name": "May",
                        "label": "★"
                    }
                ]
            },
            "transform": [
                {
                    "filter": "cycleSel == 'All' || (cycleSel == 'SC22' && datum.year_num <= 1996) || (cycleSel == 'SC23' && datum.year_num >= 1996 && datum.year_num <= 2008) || (cycleSel == 'SC24' && datum.year_num >= 2008 && datum.year_num <= 2019) || (cycleSel == 'SC25' && datum.year_num >= 2019)"
                }
            ],
            "mark": {
                "type": "text",
                "fontSize": 9,
                "color": "#ffffff",
                "fontWeight": "bold",
                "align": "center",
                "baseline": "middle"
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "ordinal"
                },
                "y": {
                    "field": "month_name",
                    "type": "ordinal",
                    "sort": [
                        "Jan",
                        "Feb",
                        "Mar",
                        "Apr",
                        "May",
                        "Jun",
                        "Jul",
                        "Aug",
                        "Sep",
                        "Oct",
                        "Nov",
                        "Dec"
                    ]
                },
                "text": {
                    "field": "label"
                }
            }
        },
        {
            "description": "Equinox month highlight rules — March and September",
            "data": {
                "values": [
                    {
                        "month_name": "Mar",
                        "label": "Equinox"
                    },
                    {
                        "month_name": "Sep",
                        "label": "Equinox"
                    }
                ]
            },
            "layer": [
                {
                    "mark": {
                        "type": "rect",
                        "opacity": 0,
                        "stroke": "#f59e0b",
                        "strokeWidth": 2
                    },
                    "encoding": {
                        "y": {
                            "field": "month_name",
                            "type": "ordinal",
                            "sort": [
                                "Jan",
                                "Feb",
                                "Mar",
                                "Apr",
                                "May",
                                "Jun",
                                "Jul",
                                "Aug",
                                "Sep",
                                "Oct",
                                "Nov",
                                "Dec"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "config": {
        "view": {
            "stroke": "transparent"
        },
        "font": "system-ui, -apple-system, sans-serif"
    }
}