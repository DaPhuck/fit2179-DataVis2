{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "background": "#111d30",
    "title": {
        "text": "Geomagnetic Storm Days per Year, 1990–2025",
        "subtitle": "Amber = any storm (Kp ≥ 5)  ·  Coral = severe storm (Kp ≥ 7)  ·  Drag on the timeline below to zoom",
        "fontSize": 18,
        "subtitleFontSize": 13,
        "font": "system-ui, -apple-system, sans-serif",
        "subtitleFont": "system-ui, -apple-system, sans-serif",
        "anchor": "start",
        "color": "#e8e2d4",
        "subtitleColor": "#7a8ba3",
        "subtitlePadding": 6,
        "offset": 12
    },
    "vconcat": [
        {
            "width": 560,
            "height": 360,
            "layer": [
                {
                    "description": "Grouped bars — storm days and severe days per year",
                    "data": {
                        "url": "https://raw.githubusercontent.com/DaPhuck/fit2179-DataVis2/refs/heads/main/data/gfz_kp_yearly.csv"
                    },
                    "transform": [
                        {
                            "filter": "datum.year < 2026"
                        },
                        {
                            "calculate": "+datum.year",
                            "as": "year_num"
                        },
                        {
                            "filter": {
                                "param": "brush"
                            }
                        },
                        {
                            "fold": [
                                "storm_days",
                                "severe_days"
                            ],
                            "as": [
                                "storm_type",
                                "days"
                            ]
                        },
                        {
                            "calculate": "datum.storm_type === 'storm_days' ? 'Storm (Kp ≥ 5)' : 'Severe (Kp ≥ 7)'",
                            "as": "label"
                        }
                    ],
                    "params": [
                        {
                            "name": "highlight",
                            "select": {
                                "type": "point",
                                "fields": [
                                    "year"
                                ],
                                "on": "mouseover"
                            }
                        }
                    ],
                    "mark": {
                        "type": "bar",
                        "cornerRadiusTopLeft": 2,
                        "cornerRadiusTopRight": 2
                    },
                    "encoding": {
                        "x": {
                            "field": "year",
                            "type": "ordinal",
                            "title": "Year",
                            "axis": {
                                "labelColor": "#e8e2d4",
                                "titleColor": "#e8e2d4",
                                "gridColor": "#2a3a52",
                                "labelFont": "system-ui, -apple-system, sans-serif",
                                "titleFont": "system-ui, -apple-system, sans-serif",
                                "labelFontSize": 10,
                                "titleFontSize": 12,
                                "titleFontWeight": "normal",
                                "labelAngle": -45,
                                "labelExpr": "parseInt(datum.value) % 5 === 0 ? datum.label : ''",
                                "grid": false,
                                "tickSize": 0
                            }
                        },
                        "xOffset": {
                            "field": "label",
                            "type": "nominal",
                            "sort": [
                                "Storm (Kp ≥ 5)",
                                "Severe (Kp ≥ 7)"
                            ]
                        },
                        "y": {
                            "field": "days",
                            "type": "quantitative",
                            "title": "Storm Days",
                            "scale": {
                                "domain": [
                                    0,
                                    130
                                ]
                            },
                            "axis": {
                                "labelColor": "#e8e2d4",
                                "titleColor": "#e8e2d4",
                                "gridColor": "#2a3a52",
                                "labelFont": "system-ui, -apple-system, sans-serif",
                                "titleFont": "system-ui, -apple-system, sans-serif",
                                "labelFontSize": 11,
                                "titleFontSize": 12,
                                "titleFontWeight": "normal",
                                "grid": true,
                                "gridOpacity": 0.15
                            }
                        },
                        "color": {
                            "field": "label",
                            "type": "nominal",
                            "scale": {
                                "domain": [
                                    "Storm (Kp ≥ 5)",
                                    "Severe (Kp ≥ 7)"
                                ],
                                "range": [
                                    "#f59e0b",
                                    "#e05c4b"
                                ]
                            },
                            "legend": {
                                "labelColor": "#e8e2d4",
                                "titleColor": "#e8e2d4",
                                "title": "Storm Type",
                                "titleFont": "system-ui, -apple-system, sans-serif",
                                "titleFontSize": 12,
                                "labelFont": "system-ui, -apple-system, sans-serif",
                                "labelFontSize": 11,
                                "orient": "right",
                                "offset": 16
                            }
                        },
                        "opacity": {
                            "condition": {
                                "param": "highlight",
                                "value": 1,
                                "empty": true
                            },
                            "value": 0.25
                        },
                        "tooltip": [
                            {
                                "field": "year",
                                "type": "ordinal",
                                "title": "Year"
                            },
                            {
                                "field": "storm_days",
                                "type": "quantitative",
                                "title": "Storm days (Kp ≥ 5)"
                            },
                            {
                                "field": "severe_days",
                                "type": "quantitative",
                                "title": "Severe days (Kp ≥ 7)"
                            },
                            {
                                "field": "total_days",
                                "type": "quantitative",
                                "title": "Days in year"
                            }
                        ]
                    }
                },
                {
                    "description": "Solar cycle peak rules and labels",
                    "data": {
                        "values": [
                            {
                                "year": "1991",
                                "year_num": 1991,
                                "label": "SC22"
                            },
                            {
                                "year": "2000",
                                "year_num": 2000,
                                "label": "SC23"
                            },
                            {
                                "year": "2015",
                                "year_num": 2015,
                                "label": "SC24"
                            },
                            {
                                "year": "2025",
                                "year_num": 2025,
                                "label": "SC25 ▲"
                            }
                        ]
                    },
                    "transform": [
                        {
                            "filter": {
                                "param": "brush"
                            }
                        }
                    ],
                    "layer": [
                        {
                            "mark": {
                                "type": "rule",
                                "strokeDash": [
                                    5,
                                    4
                                ],
                                "color": "#aaa",
                                "opacity": 0.7,
                                "strokeWidth": 1
                            },
                            "encoding": {
                                "x": {
                                    "field": "year",
                                    "type": "ordinal"
                                }
                            }
                        },
                        {
                            "mark": {
                                "type": "text",
                                "font": "system-ui, -apple-system, sans-serif",
                                "fontSize": 10,
                                "fontWeight": "bold",
                                "color": "#888",
                                "align": "center",
                                "baseline": "top",
                                "dy": 4
                            },
                            "encoding": {
                                "x": {
                                    "field": "year",
                                    "type": "ordinal"
                                },
                                "y": {
                                    "value": 0
                                },
                                "text": {
                                    "field": "label"
                                }
                            }
                        }
                    ]
                },
                {
                    "description": "Notable event annotations with leader rules",
                    "data": {
                        "values": [
                            {
                                "year": "2003",
                                "year_num": 2003,
                                "y_text": 128,
                                "y_bar": 122,
                                "text": "Halloween storms"
                            },
                            {
                                "year": "2009",
                                "year_num": 2009,
                                "y_text": 22,
                                "y_bar": 5,
                                "text": "Solar min."
                            },
                            {
                                "year": "2020",
                                "year_num": 2020,
                                "y_text": 22,
                                "y_bar": 5,
                                "text": "Solar min."
                            },
                            {
                                "year": "2024",
                                "year_num": 2024,
                                "y_text": 52,
                                "y_bar": 38,
                                "text": "May superstorm"
                            }
                        ]
                    },
                    "transform": [
                        {
                            "filter": {
                                "param": "brush"
                            }
                        }
                    ],
                    "layer": [
                        {
                            "mark": {
                                "type": "rule",
                                "color": "#d4b483",
                                "opacity": 0.55,
                                "strokeWidth": 0.8,
                                "strokeDash": [
                                    2,
                                    2
                                ]
                            },
                            "encoding": {
                                "x": {
                                    "field": "year",
                                    "type": "ordinal"
                                },
                                "y": {
                                    "field": "y_text",
                                    "type": "quantitative"
                                },
                                "y2": {
                                    "field": "y_bar"
                                }
                            }
                        },
                        {
                            "mark": {
                                "type": "text",
                                "font": "system-ui, -apple-system, sans-serif",
                                "fontSize": 10,
                                "fontStyle": "italic",
                                "fontWeight": 600,
                                "color": "#e8d6a8",
                                "align": "center",
                                "dy": -4
                            },
                            "encoding": {
                                "x": {
                                    "field": "year",
                                    "type": "ordinal"
                                },
                                "y": {
                                    "field": "y_text",
                                    "type": "quantitative"
                                },
                                "text": {
                                    "field": "text"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "description": "Timeline overview with brush — drag to filter the main chart",
            "width": 560,
            "height": 55,
            "data": {
                "url": "https://raw.githubusercontent.com/DaPhuck/fit2179-DataVis2/refs/heads/main/data/gfz_kp_yearly.csv"
            },
            "transform": [
                {
                    "filter": "datum.year < 2026"
                },
                {
                    "calculate": "+datum.year",
                    "as": "year_num"
                }
            ],
            "params": [
                {
                    "name": "brush",
                    "select": {
                        "type": "interval",
                        "encodings": [
                            "x"
                        ]
                    }
                }
            ],
            "mark": {
                "type": "bar",
                "color": "#f59e0b",
                "opacity": 0.55
            },
            "encoding": {
                "x": {
                    "field": "year_num",
                    "type": "quantitative",
                    "title": "Drag to filter ▸",
                    "scale": {
                        "domain": [
                            1989.5,
                            2025.5
                        ],
                        "nice": false
                    },
                    "axis": {
                        "labelColor": "#7a8ba3",
                        "titleColor": "#7a8ba3",
                        "titleFontSize": 10,
                        "titleFontStyle": "italic",
                        "labelFont": "system-ui, -apple-system, sans-serif",
                        "labelFontSize": 10,
                        "tickCount": 8,
                        "format": "d",
                        "grid": false
                    }
                },
                "y": {
                    "field": "storm_days",
                    "type": "quantitative",
                    "axis": null
                }
            }
        }
    ],
    "config": {
        "view": {
            "stroke": "transparent"
        },
        "font": "system-ui, -apple-system, sans-serif"
    }
}